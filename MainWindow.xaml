<Window x:Class="TimeMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:TimeMusic.Controls"
        Title="时间音乐" Width="1080" Height="700" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Microsoft YaHei UI" TextOptions.TextFormattingMode="Display"
        FontSize="13">

    <Window.Resources>
        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 外层毛玻璃窗口 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 磨砂玻璃主壳 -->
        <Border Background="{StaticResource BgBrush}" CornerRadius="18"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                MouseLeftButtonDown="Win_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ======= 顶部标题栏 ======= -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="♫" FontSize="18" Foreground="{StaticResource ThemeBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="时间音乐" FontSize="15" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Style="{StaticResource WindowButton}" Click="Settings_Click" Content="⚙" ToolTip="设置"/>
                        <Button Style="{StaticResource WindowButton}" Click="Min_Click" Content="—" ToolTip="最小化"/>
                        <Button Style="{StaticResource WindowButton}" Click="Close_Click" Content="✕" ToolTip="关闭"/>
                    </StackPanel>
                </Grid>

                <!-- ======= 主体三栏 ======= -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左:时间歌单栏 -->
                    <Border Grid.Column="0" Style="{StaticResource GlassCard}" Margin="8,4,0,8">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,8">
                                <TextBlock Text="时间歌单" FontSize="15" FontWeight="Bold"/>
                                <TextBlock x:Name="ClockText" Text="--:--" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource ThemeBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Row="1" x:Name="AddBtn" Margin="10,2,10,10" Height="36"
                                    Style="{StaticResource FlatButton}" Background="{StaticResource GlassBrush2}"
                                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1"
                                    Click="AddPlaylist_Click">
                                <TextBlock Text="＋ 新建时间歌单" FontSize="13"/>
                            </Button>
                            <ListBox Grid.Row="2" x:Name="PlaylistList" ItemContainerStyle="{StaticResource PlaylistItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="PlaylistList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="⏰" FontFamily="Segoe UI Symbol" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}" x:Name="NameText"
                                                           MouseLeftButtonDown="Name_MouseLeftButtonDown"/>
                                            </Grid>
                                            <DockPanel Grid.Row="1" Margin="22,4,0,0">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource MiniBtn}" Content="根目录" Tag="{Binding}" Click="RootDir_Click"/>
                                                    <Button Style="{StaticResource MiniBtn}" Content="时间" Tag="{Binding}" Click="TimeBtn_Click"/>
                                                    <Button Style="{StaticResource MiniBtn}" Content="✕" Tag="{Binding}" Click="DeleteBtn_Click"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding TimeRangeText}" FontSize="11" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 中左:垂直进度条 -->
                    <Grid Grid.Column="1" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="CurTimeText" Text="00:00" FontSize="10"
                                   Foreground="{StaticResource ThemeBrush}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <Grid Grid.Row="1">
                            <controls:VerticalProgressBar x:Name="ProgressBar" Width="8" HorizontalAlignment="Center"
                                                          BarBrush="{StaticResource ThemeBrush}"
                                                          MouseLeftButtonDown="ProgressBar_MouseDown"/>
                        </Grid>
                        <TextBlock Grid.Row="2" x:Name="TotalTimeText" Text="00:00" FontSize="10"
                                   Foreground="{StaticResource DimTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                    </Grid>

                    <!-- 中:播放区 -->
                    <Grid Grid.Column="2" Margin="6,4,6,8">
                        <Border Style="{StaticResource GlassCard}" Margin="0">
                            <Grid Margin="24,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- 顶部:歌曲信息 + 模式 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="SongTitleText" Text="时间音乐" FontSize="24" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ModeBtn" Style="{StaticResource MiniBtn}"
                                            Background="{StaticResource GlassBrush2}" BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1" Content="顺序" Click="Mode_Click" VerticalAlignment="Top"/>
                                </Grid>

                                <!-- 中部:封面 + 歌词 -->
                                <Grid Grid.Row="1" Margin="0,14,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 封面/唱片 -->
                                    <Border Grid.Column="0" Width="200" Height="200" CornerRadius="100"
                                            Background="{StaticResource GlassBrush2}" BorderBrush="{StaticResource GlassBorderBrush}"
                                            BorderThickness="1" VerticalAlignment="Center">
                                        <Border.Clip>
                                            <EllipseGeometry RadiusX="100" RadiusY="100" Center="100,100"/>
                                        </Border.Clip>
                                        <Grid>
                                            <Image x:Name="CoverArt" Stretch="UniformToFill" StretchDirection="DownOnly"
                                                   Opacity="0.95"/>
                                            <Ellipse Fill="#80000000" Stroke="White" StrokeThickness="1.5" Width="54" Height="54"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.6" Color="#000000"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                            <TextBlock Text="♫" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- 歌词 -->
                                    <Grid Grid.Column="1" Margin="22,0,0,0">
                                        <ListBox x:Name="LyricList" ItemContainerStyle="{StaticResource LyricItem}"
                                                 Background="Transparent" BorderThickness="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 IsHitTestVisible="False" Focusable="False"/>
                                        <TextBlock x:Name="BigTitleText" Text="时间音乐"
                                                   FontSize="34" FontWeight="Bold"
                                                   Foreground="{StaticResource ThemeDimBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Margin="20,0" Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>

                                <!-- 底部:横向进度条 -->
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" x:Name="SeekCurText" Text="00:00" FontSize="11" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" x:Name="SeekSlider" Style="{StaticResource GlassSlider}" Margin="14,0"
                                            Minimum="0" Maximum="1000" ValueChanged="SeekSlider_ValueChanged"
                                            PreviewMouseDown="SeekSlider_PreviewMouseDown" PreviewMouseUp="SeekSlider_PreviewMouseUp"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" x:Name="SeekTotalText" Text="00:00" FontSize="11" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 右:歌曲队列 -->
                    <Border Grid.Column="3" Style="{StaticResource GlassCard}" Margin="0,4,8,8">
                        <Grid Margin="8,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="10,10,10,6">
                                <TextBlock DockPanel.Dock="Left" Text="播放队列" FontSize="14" FontWeight="Bold"/>
                                <TextBlock x:Name="QueueCount" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Button Grid.Row="1" x:Name="QueueToggle" Style="{StaticResource MiniBtn}" Content="收起队列 ▾"
                                    Margin="10,0,10,4" Background="{StaticResource GlassBrush2}" BorderBrush="{StaticResource GlassBorderBrush}"
                                    BorderThickness="1" Click="QueueToggle_Click" HorizontalAlignment="Stretch"/>
                            <ListBox Grid.Row="2" x:Name="SongList" ItemContainerStyle="{StaticResource SongItem}"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="SongList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="♪" FontSize="12" Foreground="{StaticResource ThemeBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10"
                                                       Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======= 底部控制栏 ======= -->
                <Grid Grid.Row="2" Margin="10,0,10,10">
                    <Border Style="{StaticResource GlassPanel}" CornerRadius="16" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 播放控制 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Click="Prev_Click" Content="⏮" FontSize="15"/>
                                <Button Style="{StaticResource PlayButton}" Click="PlayPause_Click" x:Name="PlayBtn" Content="▶" Margin="10,0"/>
                                <Button Style="{StaticResource IconButton}" Click="Next_Click" Content="⏭" FontSize="15"/>
                            </StackPanel>

                            <!-- 音量 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,4,0">
                                <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center"/>
                                <Slider x:Name="VolumeSlider" Style="{StaticResource GlassSlider}" Width="120" Margin="8,0,0,0"
                                        Minimum="0" Maximum="1" ValueChanged="VolumeSlider_ValueChanged"
                                        VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>