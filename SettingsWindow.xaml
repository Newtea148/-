<Window x:Class="TimeMusic.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="480" Height="680" WindowStartupLocation="CenterOwner"
        Background="Transparent" Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True">
    <Border Background="{StaticResource BgBrush}" CornerRadius="16"
            BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" Margin="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="设置" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="界面主题色" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="ColorWrap" Height="46">
                        <!-- 颜色块由代码填充 -->
                    </WrapPanel>

                    <TextBlock Text="播放设置" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="播放模式" FontSize="12" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="ModeCombo" FontSize="13" VerticalAlignment="Center"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="顺序播放"/>
                            <ComboBoxItem Content="随机播放"/>
                            <ComboBoxItem Content="单曲循环"/>
                            <ComboBoxItem Content="列表循环"/>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="0,12,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="默认音量" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Slider x:Name="VolumeSlider" Style="{StaticResource GlassSlider}" Width="220"
                                    Minimum="0" Maximum="1" Value="0.8"/>
                            <TextBlock x:Name="VolumeLabel" Text="80%" FontSize="11" Foreground="{StaticResource DimTextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="界面显示" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6"/>
                    <CheckBox x:Name="LyricsCheck" Content="显示歌词" FontSize="13" Margin="0,4,0,0" Style="{StaticResource GlassCheck}"/>
                    <CheckBox x:Name="QueueCheck" Content="显示播放队列" FontSize="13" Margin="0,12,0,0" Style="{StaticResource GlassCheck}"/>
                    <CheckBox x:Name="DesktopCheck" Content="桌面歌词" FontSize="13" Margin="0,12,0,0" Style="{StaticResource GlassCheck}"/>

                    <TextBlock Text="音乐均衡器" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6"/>
                    <ItemsControl x:Name="EqItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Freq}" FontSize="12" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Height="28"
                                            Value="{Binding Gain, Mode=TwoWay}" Minimum="-15" Maximum="15"
                                            SmallChange="1" LargeChange="3" IsSnapToTickEnabled="True" TickFrequency="1"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Gain}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" FontSize="13" Margin="0,20,0,0" Style="{StaticResource GlassCheck}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Style="{StaticResource FlatButton}" Click="ChooseDir_Click" Content="更改音乐读取目录" Padding="14,9" Background="{StaticResource GlassBrush2}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}" Click="Ok_Click" Content="确定" Padding="26,9" FontSize="14"/>
                <Button Style="{StaticResource FlatButton}" Click="Cancel_Click" Content="取消" Padding="22,9" Margin="10,0,0,0" Background="{StaticResource GlassBrush2}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" FontSize="14"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>