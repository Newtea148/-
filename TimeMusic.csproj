<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>TimeMusic</RootNamespace>
    <AssemblyName>TimeMusic</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>时间音乐</Authors>
    <Product>时间音乐</Product>
    <Description>时间音乐 - 本地时间歌单播放器</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <!-- Self-contained + Single-file 发布 -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>


  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- BASS.NET 托管封装 -->
    <Reference Include="Bass.Net">
      <HintPath>libs\Bass.Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 原生 BASS dll:复制到输出目录 + 作为嵌入资源(用于单文件自解压) -->
  <ItemGroup>
    <EmbeddedResource Include="libs\bass.dll" LogicalName="TimeMusic.natives.bass.dll" />
    <EmbeddedResource Include="libs\bass_fx.dll" LogicalName="TimeMusic.natives.bass_fx.dll" />
    <EmbeddedResource Include="libs\bassflac.dll" LogicalName="TimeMusic.natives.bassflac.dll" />
    <EmbeddedResource Include="libs\bass_aac.dll" LogicalName="TimeMusic.natives.bass_aac.dll" />
    <EmbeddedResource Include="libs\bassape.dll" LogicalName="TimeMusic.natives.bassape.dll" />
    <EmbeddedResource Include="libs\basswma.dll" LogicalName="TimeMusic.natives.basswma.dll" />
    <EmbeddedResource Include="libs\bassopus.dll" LogicalName="TimeMusic.natives.bassopus.dll" />
    <EmbeddedResource Include="libs\bassmix.dll" LogicalName="TimeMusic.natives.bassmix.dll" />
    <EmbeddedResource Include="libs\bassalac.dll" LogicalName="TimeMusic.natives.bassalac.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Update="libs\Bass.Net.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>