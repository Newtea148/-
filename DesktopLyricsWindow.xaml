<Window x:Class="TimeMusic.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" Topmost="True" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" SizeToContent="WidthAndHeight"
        Width="560" MaxWidth="900" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        MouseLeftButtonDown="Win_MouseDown">
    <Border Background="#E6202533" CornerRadius="14" Padding="18,10"
            BorderBrush="#553F4A6B" BorderThickness="1" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="＋" Click="Bigger_Click" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Cursor="Hand"/>
                <Button Content="－" Click="Smaller_Click" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Cursor="Hand"/>
                <Button Content="✕" Click="Close_Click" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Cursor="Hand"/>
            </StackPanel>
            <TextBlock Grid.Row="1" x:Name="LyricText" Text="" FontSize="26"
                       Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,4,0,2"/>
        </Grid>
    </Border>
</Window>